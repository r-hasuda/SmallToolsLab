---
export interface Props {
  title: string;
  description: string;
  icon: string;
  guideUrl?: string;
  aboutText?: string;
  recommendedFor?: string[];
  steps?: string[];
  faq?: { q: string; a: string }[];
  appUrl?: string;
}

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  description,
  icon,
  guideUrl,
  aboutText,
  recommendedFor = [],
  steps = [],
  faq = [],
  appUrl,
} = Astro.props;
---

<Layout
  title={`${title} | SmallTools Lab`}
  description={description}
>
  <Header />

  <main class="bg-gray-50">
    <!-- アプリ紹介ヘッダー -->
    <div class="bg-swell-navy text-white py-10 px-6">
      <div class="max-w-4xl mx-auto text-center">
        <span class="text-4xl mb-4 block">{icon}</span>
        <h1 class="text-2xl md:text-3xl font-bold mb-3">{title}</h1>
        <p class="text-sm opacity-80 max-w-2xl mx-auto">
          {description}
        </p>
      </div>
    </div>

    <!-- ツール本体エリア -->
    <div class="max-w-6xl mx-auto px-4 py-8">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <slot />
      </div>

      <!-- フォールバック -->
      {appUrl && (
        <p class="text-center text-sm text-gray-500 mt-4">
          アプリが表示されない場合は
          <a
            href={appUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-swell-blue hover:underline"
          >
            こちらから直接開けます →
          </a>
        </p>
      )}
    </div>

    <!-- AdSense Placeholder: ツール直下 -->
    <!-- <div class="max-w-4xl mx-auto px-6 py-4"><ins class="adsbygoogle" data-ad-slot="XXXXXXXXXX"></ins></div> -->

    <!-- 解説記事エリア -->
    <div class="max-w-3xl mx-auto px-6 pb-16">

      <!-- このツールについて -->
      {aboutText && (
        <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 mb-8">
          <h2 class="text-xl font-bold text-gray-800 mb-4 border-l-4 border-swell-blue pl-3">
            このツールについて
          </h2>
          {aboutText && (
            <p class="text-sm text-gray-700 leading-relaxed mb-4">
              {aboutText}
            </p>
          )}
          {recommendedFor.length > 0 && (
            <div class="bg-blue-50 border border-blue-100 rounded-xl p-5 mb-4">
              <p class="text-sm font-bold text-gray-800 mb-2">こんな方におすすめ</p>
              <ul class="list-disc pl-5 space-y-1">
                {recommendedFor.map((item) => (
                  <li class="text-sm text-gray-700 leading-relaxed">{item}</li>
                ))}
              </ul>
            </div>
          )}
        </section>
      )}

      <!-- 使い方・活用ステップ -->
      {steps.length > 0 && (
        <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
          <h2 class="text-xl font-bold text-gray-800 mb-6 border-l-4 border-swell-blue pl-3">
            使い方・活用ステップ
          </h2>
          <ol class="space-y-4">
            {steps.map((step, index) => (
              <li class="flex gap-4 items-start">
                <span class="flex-shrink-0 w-8 h-8 bg-swell-blue text-white rounded-full flex items-center justify-center text-sm font-bold">
                  {index + 1}
                </span>
                <p class="text-sm text-gray-700 leading-relaxed pt-1">
                  {step}
                </p>
              </li>
            ))}
          </ol>
          {guideUrl && (
            <div class="text-center mt-8">
              <a
                href={guideUrl}
                class="inline-flex items-center gap-2 bg-swell-navy text-white text-sm font-bold py-3 px-8 rounded-xl hover:bg-swell-navy/90 transition-all duration-200 hover:shadow-lg"
              >
                📖 詳しい使い方を見る
              </a>
            </div>
          )}
        </section>
      )}

      <!-- よくある質問 -->
      {faq.length > 0 && (
        <section class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 mt-8">
          <h2 class="text-xl font-bold text-gray-800 mb-6 border-l-4 border-swell-blue pl-3">
            よくある質問
          </h2>
          <div class="space-y-6">
            {faq.map((item) => (
              <div>
                <p class="text-sm font-bold text-gray-800 mb-1.5 flex gap-2">
                  <span class="text-swell-blue">Q.</span>
                  {item.q}
                </p>
                <p class="text-sm text-gray-700 leading-relaxed pl-6">
                  {item.a}
                </p>
              </div>
            ))}
          </div>
        </section>
      )}

    </div>

    <!-- AdSense Placeholder: 記事最後 -->
    <!-- <div class="max-w-4xl mx-auto px-6 py-4"><ins class="adsbygoogle" data-ad-slot="XXXXXXXXXX"></ins></div> -->

  </main>

  <Footer />
</Layout>
